# Copy this file to .env in this folder and fill in the key.
#
#     cp .env.example .env
#
# Every agent in this homework reaches gpt-6-luna through Portkey, so this is
# the only credential the project needs. backend/config.py looks for a .env here
# first, then falls back to one in the folder above.
PORTKEY_API_KEY=your-portkey-key-here
